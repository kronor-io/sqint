packages: .

optimization: False

-- sqitch-plan and libpg-query are on Hackage, but released after this
-- index-state and after the hackage.nix the flake reads, so they are pinned to
-- their release commits here: tag is the commit, and --sha256 is what
-- haskell.nix checks it against (nix-prefetch-git --quiet --url <location>
-- --rev <commit>). Drop both once the index-state moves past them.
source-repository-package
  type:     git
  location: https://github.com/kronor-io/sqitch-plan
  tag:      6b73832c208620f79c3346cdb50d80595f67a884
  --sha256: 0gamsz2zjcrs17lmy3dv9n41bw1a01kwy4pncaf255113sckb2fq

source-repository-package
  type:     git
  location: https://github.com/kronor-io/pg-query
  tag:      42686bb8411052a479325843fefbf1c1aec31e71
  --sha256: 1dgsi5v2fa1qa12ijba7vz902qk69nwb8zx6g5y1jnqhdchx34vb

constraints:
  hasql == 2.0.1.0,
  pqi == 1.1.0.1,
  pqi-ffi == 1.0.1.0

package postgresql-libpq
  flags: +use-pkg-config

index-state: hackage.haskell.org 2026-10-26T00:00:00Z
